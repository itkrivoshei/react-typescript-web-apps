{
  "name": "react-typescript-web-apps",
  "version": "0.1.0",
  "description": "A collection of React and TypeScript frontend applications built during frontend training.",
  "license": "MIT",
  "repository": "https://github.com/itkrivoshei/react-typescript-web-apps",
  "private": true,
  "homepage": "https://itkrivoshei.github.io/react-typescript-web-apps/",
  "dependencies": {
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/gideon-roman": "^5.1.0",
    "@fontsource/orbitron": "^5.1.0",
    "@fontsource/space-mono": "^5.1.0",
    "@mui/icons-material": "^6.1.0",
    "@mui/material": "^6.1.0",
    "@reduxjs/toolkit": "^2.2.7",
    "@types/react": "^18.3.6",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "eslint-plugin-react": "^7.36.1",
    "framer-motion": "^11.5.4",
    "howler": "^2.2.4",
    "react": "^18.3.1",
    "react-dom": "^19.2.6",
    "react-icons": "^5.3.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2",
    "react-scripts": "^5.0.1",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"public/**/*.html\" \"*.{json,js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"public/**/*.html\" \"*.{json,js,mjs}\"",
    "pretty": "npm run format",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "eject": "react-scripts eject"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "gh-pages": "^6.1.1",
    "prettier": "^3.3.3",
    "sass": "^1.78.0",
    "typescript": "^4.9.5"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
